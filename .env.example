# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase project (Project Settings > API). The publishable key is designed to be used in the browser;
# the data is protected by row level security, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Names printed on every PAF claim form (optional).
NEXT_PUBLIC_PAF_DISTRIBUTOR_REP=
NEXT_PUBLIC_PAF_CD_REP=
