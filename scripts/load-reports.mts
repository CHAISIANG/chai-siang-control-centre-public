// Turns the four weekly Excel reports into one SQL file that replaces the report data in Supabase.
//   npx tsx scripts/load-reports.mts "C:\path\to\the\folder\with\the\reports"
// It finds the reports by their headers, so file names do not matter. The SQL is written to supabase/seed/ (never committed).
// Then run it:   npx supabase db query --remote --yes -f supabase/seed/10_real_reports.sql
import { readdirSync, statSync, mkdirSync, writeFileSync } from "node:fs";
import { join, basename } from "node:path";
import { readSheet } from "read-excel-file/node";
import { detectReport, parseAging, parseCoverage, parseCustomers, parseProducts, type Kind, type Row } from "../src/lib/reports";

const root = process.argv[2];
if (!root) { console.error('Give the folder that holds the reports, for example: npx tsx scripts/load-reports.mts "C:\\Users\\me\\Desktop\\CSSB 1.0"'); process.exit(1); }

function walk(dir: string, out: string[] = []): string[] {
  for (const name of readdirSync(dir)) {
    if (name === "node_modules" || name.startsWith(".") || name.startsWith("~$")) continue;
    const p = join(dir, name);
    const s = statSync(p);
    if (s.isDirectory()) walk(p, out); else if (/\.xlsx$/i.test(name)) out.push(p);
  }
  return out;
}

const found: Partial<Record<Kind, { file: string; rows: Row[]; mtime: number }>> = {};
for (const f of walk(root)) {
  let rows: Row[];
  try { rows = (await readSheet(f)) as Row[]; } catch { continue; }
  const kind = detectReport(rows);
  if (!kind) continue;
  const mtime = statSync(f).mtimeMs;
  if (!found[kind] || mtime > found[kind]!.mtime) found[kind] = { file: f, rows, mtime };
}
const missing = (["aging", "coverage", "products", "customers"] as Kind[]).filter((k) => !found[k]);
if (missing.length) { console.error(`Could not find: ${missing.join(", ")}. Nothing was written.`); process.exit(1); }

// ---- SQL helpers ----
const q = (s: string | undefined | null) => (s === undefined || s === null || s === "" ? "null" : `'${String(s).replace(/'/g, "''")}'`);
const n = (v: number | null | undefined) => (v === null || v === undefined || !Number.isFinite(v) ? "null" : String(Math.round(v * 100) / 100));
const d = (s: string) => (s ? `'${s}'::date` : "null");
const chunks = <T,>(l: T[], size: number): T[][] => { const o: T[][] = []; for (let i = 0; i < l.length; i += size) o.push(l.slice(i, i + size)); return o; };
const title = (s: string) => s.toLowerCase().replace(/\b\w/g, (m) => m.toUpperCase());

const aging = parseAging(found.aging!.rows), cov = parseCoverage(found.coverage!.rows), prod = parseProducts(found.products!.rows), cust = parseCustomers(found.customers!.rows);

// The report date: due date plus how many days late each invoice is.
const withDue = aging.invoices.filter((i) => i.due);
const dates = new Map<string, number>();
for (const i of withDue) { const t = new Date(i.due + "T00:00:00Z").getTime() + i.age * 86400000; const iso = new Date(t).toISOString().slice(0, 10); dates.set(iso, (dates.get(iso) ?? 0) + 1); }
const asAt = [...dates.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
if (!asAt) { console.error("Could not work out the aging report date."); process.exit(1); }

const out: string[] = [];
out.push("-- Generated by scripts/load-reports.mts. Real business data: never commit this file.", "begin;");

// salesmen and their monthly figures
out.push("insert into public.salesmen (code, name) values");
out.push(cov.reps.map((r) => `  (${q(r.code)}, ${q(title(r.name))})`).join(",\n") + "\non conflict (code) do nothing;");
const monthly: string[] = [];
for (const r of cov.reps) for (let m = 0; m < 11; m++) monthly.push(`(${q(r.code)}, 2026, ${m + 1}, ${n(r.rl[m])}, ${n(r.active[m])}, ${n(r.erc[m])}, ${n(r.target[m] ?? null)}, ${n(r.sales[m])})`);
out.push("insert into public.salesman_monthly (salesman_code, year, month, rl_acct, active_acct, erc, sales_target, net_sales) values", monthly.join(",\n"),
  "on conflict (salesman_code, year, month) do update set rl_acct = excluded.rl_acct, active_acct = excluded.active_acct, erc = excluded.erc, sales_target = excluded.sales_target, net_sales = excluded.net_sales;");

// open invoices (replaced in full each time)
out.push("delete from public.ar_invoices;");
for (const c of chunks(aging.invoices, 400)) {
  out.push("insert into public.ar_invoices (doc_no, doc_date, cust_code, customer, terms, due_date, agent, amount, outstanding, note, as_at) values");
  out.push(c.map((i) => `(${q(i.doc)}, ${d(i.date)}, ${q(i.custCode)}, ${q(i.customer)}, ${n(i.terms)}, ${d(i.due)}, ${q(i.agent)}, ${n(i.amount)}, ${n(i.outstanding)}, ${q(i.note)}, '${asAt}'::date)`).join(",\n") + "\non conflict (doc_no) do update set outstanding = excluded.outstanding, as_at = excluded.as_at;");
}

// sales by customer (replaced in full)
out.push("delete from public.customer_sales;");
const cs = cust.customers.filter((c) => c.ytd !== 0 || c.pyAms !== 0 || c.months.some((x) => x !== 0));
for (const c of chunks(cs, 300)) {
  out.push("insert into public.customer_sales (code, name, year, months, ytd, ytd_ams, py_ams, as_at) values");
  out.push(c.map((x) => `(${q(x.code)}, ${q(x.name)}, 2026, ARRAY[${[...x.months, 0].slice(0, 12).map((v) => n(v)).join(",")}]::numeric[], ${n(x.ytd)}, ${n(x.ytdAms)}, ${n(x.pyAms)}, '${asAt}'::date)`).join(",\n") + ";");
}

// invoice lines: replace only the dates the report covers
const dts = prod.lines.map((l) => l.date).filter(Boolean).sort();
out.push(`delete from public.sales_lines where sale_date between '${dts[0]}'::date and '${dts[dts.length - 1]}'::date;`);
for (const c of chunks(prod.lines, 400)) {
  out.push("insert into public.sales_lines (sale_date, invoice_no, product_code, product_desc, rep_code, rep_name, cust_code, cust_name, qty_cs, qty_ea, gross, promo_disc, qty_disc, inv_disc, net) values");
  out.push(c.map((l) => `(${d(l.date)}, ${q(l.invoice)}, ${q(l.product)}, ${q(l.desc)}, ${q(l.rep)}, ${q(l.repName)}, ${q(l.custCode)}, ${q(l.customer)}, ${n(l.qtyCS)}, ${n(l.qtyEA)}, ${n(l.gross)}, ${n(l.promoDisc)}, ${n(l.qtyDisc)}, ${n(l.invDisc)}, ${n(l.net)})`).join(",\n") + ";");
}

// upload log
const logs: [string, Kind, number][] = [["Aging", "aging", aging.invoices.length], ["Coverage and Net Sales", "coverage", cov.reps.length * 11], ["Sales by Products and Sales Rep", "products", prod.lines.length], ["Net Sales by Customer", "customers", cs.length]];
out.push("insert into public.upload_log (report, file_name, row_count, status) values", logs.map(([r, k, c]) => `(${q(r)}, ${q(basename(found[k]!.file))}, ${c}, 'OK')`).join(",\n") + ";");
out.push("commit;");

mkdirSync("supabase/seed", { recursive: true });
writeFileSync("supabase/seed/10_real_reports.sql", out.join("\n") + "\n", "utf8");
console.log(`Report date ${asAt}. Aging ${aging.invoices.length} invoices (RM ${aging.sum.toLocaleString()}), coverage ${cov.reps.length} salesmen, sales lines ${prod.lines.length} (${dts[0]} to ${dts[dts.length - 1]}), customers ${cs.length}.`);
console.log("Wrote supabase/seed/10_real_reports.sql");
